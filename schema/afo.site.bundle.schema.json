{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nothinginfinity/afo-site-bundle-contract/schema/afo.site.bundle.schema.json",
  "title": "AFO Site Bundle Manifest v1",
  "description": "Shared contract between AFO Micro SEO Site Builder MCP and AFO Mobile Terminal / Deploy MCP. GitHub is source of truth; Cloudflare is runtime only.",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "bundle_id",
    "bundle_type",
    "status",
    "created_at",
    "updated_at",
    "build_intent",
    "client",
    "site",
    "content",
    "discovery",
    "schema_jsonld",
    "worker",
    "repo",
    "validation",
    "deployment",
    "smoke_tests",
    "registry",
    "handoff"
  ],
  "properties": {
    "schema": { "type": "string", "const": "afo.site.bundle" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "bundle_id": { "type": "string", "format": "uuid" },
    "bundle_type": { "type": "string", "enum": ["micro_seo_site", "landing_page", "service_site", "custom"] },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "generated",
        "validated",
        "preview_ready",
        "preview_deployed",
        "smoke_tested",
        "production_ready",
        "production_deployed",
        "registered",
        "receipted",
        "failed"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "build_intent": { "type": "string" },
    "client": {
      "type": "object",
      "required": ["name", "industry"],
      "properties": {
        "name": { "type": "string" },
        "industry": { "type": "string" },
        "location": { "type": "string" },
        "contact_email": { "type": "string" },
        "phone": { "type": "string" }
      },
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["base_url", "domain", "title", "description", "language"],
      "properties": {
        "base_url": { "type": "string" },
        "domain": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string", "default": "en" }
      },
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "properties": {
        "services": { "type": "array" },
        "pages": { "type": "array" },
        "articles": { "type": "array" },
        "faqs": { "type": "array" },
        "calls_to_action": { "type": "array" }
      },
      "additionalProperties": true
    },
    "discovery": {
      "type": "object",
      "properties": {
        "llms_txt": { "type": "string" },
        "robots_txt": { "type": "string" },
        "sitemap_xml": { "type": "string" },
        "sitemap_json": { "type": "object" },
        "agent_actions": { "type": "object" },
        "canonical_url": { "type": "string" }
      },
      "additionalProperties": true
    },
    "schema_jsonld": { "type": "object" },
    "worker": {
      "type": "object",
      "required": ["name", "entry_point", "compatibility_date"],
      "properties": {
        "name": { "type": "string" },
        "entry_point": { "type": "string" },
        "compatibility_date": { "type": "string" },
        "routes": { "type": "array", "items": { "type": "string" } },
        "bindings": { "type": "object" }
      },
      "additionalProperties": true
    },
    "repo": {
      "type": "object",
      "required": ["owner", "repo", "branch", "worker_path", "bundle_path"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "branch": { "type": "string" },
        "worker_path": { "type": "string" },
        "bundle_path": { "type": "string" },
        "receipts_path": { "type": "string" },
        "handoff_path": { "type": "string" }
      },
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "properties": {
        "passed": { "type": "boolean" },
        "validated_at": { "type": ["string", "null"] },
        "validated_by": { "type": ["string", "null"] },
        "checks": { "type": "array" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": ["deploy_mode", "confirmed", "environment"],
      "properties": {
        "deploy_mode": { "type": "string", "enum": ["preview_first"] },
        "confirmed": { "type": "boolean", "const": false, "description": "Default must be false. Production deployment requires an explicit operator-confirmed change." },
        "environment": { "type": "string", "enum": ["preview", "production"] },
        "preview_url": { "type": "string" },
        "production_url": { "type": "string" },
        "last_deploy": { "type": ["object", "string", "null"] },
        "deploy_receipts": { "type": "array" }
      },
      "additionalProperties": true
    },
    "smoke_tests": {
      "type": "object",
      "properties": {
        "routes": { "type": "array" },
        "tests": { "type": "array" },
        "last_smoke_test": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "registry": {
      "type": "object",
      "properties": {
        "registered": { "type": "boolean" },
        "registered_at": { "type": ["string", "null"] },
        "tags": { "type": "array" }
      },
      "additionalProperties": true
    },
    "handoff": {
      "type": "object",
      "properties": {
        "created_by": { "type": "string" },
        "last_updated_by": { "type": "string" },
        "next_action": { "type": "string" },
        "next_agent": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
